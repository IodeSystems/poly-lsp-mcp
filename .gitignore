/poly-lsp-mcp
/embed
/dist/
# bin/dev is the tracked launcher; the binaries it builds are not
# (the bare name and the per-arch bin/poly-lsp-mcp-<os>-<arch>).
/bin/poly-lsp-mcp
/bin/poly-lsp-mcp-*
*.test
*.out
.idea/
.vscode/
# poly-lsp's own cache dir — at the root or nested in a test fixture
.poly-lsp-mcp/
# Python bytecode cache for the smoke scripts
__pycache__/
*.pyc
